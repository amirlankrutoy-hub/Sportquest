# Client ID из Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# В «Authorized JavaScript origins» добавь http://localhost:3000 (и адрес сайта после деплоя).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Отправка кодов подтверждения на почту. Для Gmail:
# 1) включи двухэтапную проверку в аккаунте Google;
# 2) создай пароль приложения: https://myaccount.google.com/apppasswords
# 3) SMTP_USER — этот Gmail, SMTP_PASS — 16-значный пароль приложения (без пробелов).
# Без этих настроек сайт работает в демо-режиме и показывает код прямо на экране.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
